# Copy to .env (never commit .env). All values are optional unless noted.

# Database: SQLite by default; PostgreSQL for shared deployments.
# DATABASE_URL=postgresql+psycopg://mie:password@localhost:5432/mie
# DATABASE_URL=sqlite:////absolute/path/to/mie.db   (default: data/mie.db inside the project)

# Public APIs ask for an identifying User-Agent. SEC EDGAR REQUIRES a contact e-mail in it.
HTTP_USER_AGENT=MarketIntelPrototype/0.1 (research team; contact: you@example.com)
HTTP_TIMEOUT_S=20
HTTP_MAX_ATTEMPTS=4

# BLS API v2 registration key (free). Without it, the v1 endpoint is used (lower limits).
BLS_API_KEY=

# Dedup parameters. UNCALIBRATED defaults; see docs/ARCHITECTURE.md §10.
DEDUP_SIMILARITY_THRESHOLD=0.35
DEDUP_WINDOW_HOURS=72

# FinBERT (local). Pin FINBERT_REVISION to a commit hash once validated.
FINBERT_ENABLED=true
FINBERT_MODEL=ProsusAI/finbert
FINBERT_REVISION=main

# Claude. Off by default: enabling it sends event briefs from sources marked
# allow_external_llm=true to Anthropic's API. Requires ANTHROPIC_API_KEY.
CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Optional: low | medium | high | xhigh | max (omit for the API default)
CLAUDE_EFFORT=
CLAUDE_EVENT_TYPES=MONETARY_POLICY,INFLATION,GDP,EMPLOYMENT,FISCAL_POLICY,EARNINGS,GUIDANCE,CREDIT_RATING,M&A,COMMODITY,FX,BOND_AUCTION,SUPPLY_DISRUPTION,GEOPOLITICS
BRIEF_MAX_STATEMENTS_PER_LAYER=8
# Send events the keyword rules left as OTHER to Claude for a constrained type label.
CLAUDE_TYPE_OTHER_EVENTS=true
